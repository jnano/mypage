# frontend/.env.local 로 복사해 쓴다(서버 전용 값 — NEXT_PUBLIC_ 접두어를 붙이지 않는다)

# 실행 환경: dev | test | prod (기본 prod)
APP_ENV=dev
# FastAPI 주소
BACKEND_URL=http://localhost:8000
# FastAPI 쓰기 경계용 공유 비밀 — backend/.env 의 INTERNAL_API_SECRET 과 같은 값(prod 는 32자 이상)
INTERNAL_API_SECRET=
# 개발 로그인(/dev/login) — APP_ENV=dev 에서만. 켜면 쿠키를 X-Dev-Member 헤더로 바꿔 FastAPI 에 보낸다
# DEV_VIEWER_SECRET 은 backend/.env 의 DEV_VIEWER_SECRET 과 같은 값(16자 이상)
DEV_VIEWER_LOGIN=false
DEV_VIEWER_SECRET=
