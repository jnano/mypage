APP_NAME=mypage
DEBUG=true
# 실행 환경: dev | test | prod (기본 prod)
ENV=dev
DATABASE_URL=postgresql+asyncpg://taehunkang@localhost:5432/mypage

# DB 연결 풀 (기본값 그대로면 생략 가능)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_POOL_PRE_PING=false

# 테스트 DB — pytest 가 DATABASE_URL 대신 쓴다. DB 이름은 _test 로 끝나야 한다
# TEST_DATABASE_URL=postgresql+asyncpg://taehunkang@localhost:5432/mypage_test

# 개발용 Viewer 헤더 — ENV=dev 에서만 켤 수 있다(그 밖에는 기동 실패). 비밀 값 16자 이상
# 요청 헤더 형식: X-Dev-Member: {회원 id}; key={DEV_VIEWER_SECRET}
# DEV_VIEWER_HEADER=true
# DEV_VIEWER_SECRET=

# Next 서버 → FastAPI 내부 호출 비밀(상태를 바꾸는 요청에 필요). frontend/.env.local 의 같은 이름과 같은 값.
# ENV=prod 에서는 32자 이상 필수. 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_API_SECRET=

# 요청 계측(§15.3): 응답에 Server-Timing(app·db 시간, 쿼리 수). 측정할 때만 true
# SERVER_TIMING=false
