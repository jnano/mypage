# /etc/mypage/backend.env — 값과 뜻은 deploy/README.md '3. 환경 변수'
# 필수 — 값을 채운다(빈 값이면 기동 실패)
ENV=
DATABASE_URL=
INTERNAL_API_SECRET=
EMAIL_HMAC_SECRET=
IP_HASH_SECRET=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
MEDIA_ROOT=
PRIVATE_ROOT=
FILE_SENDER=
# 선택 — 기본값을 쓰려면 주석 그대로 둔다. 바꿀 때만 주석을 풀고 값을 적는다(빈 값 금지 — 기동 실패이거나 쓰일 때 깨진다).
# 줄 끝 주석 금지 — systemd EnvironmentFile 은 '#' 로 시작하는 줄만 주석으로 보고, 줄 끝 '# …' 은 값에 붙는다
# DEBUG=false
# uvicorn 프로세스 수 — 코어 수의 절반(최소 2). 안 적으면 유닛 기본 2
# WEB_CONCURRENCY=2
# NEXT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
